# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/researchmate
# Example: postgresql://postgres:postgres@localhost:5432/researchmate

# LLM Configuration (OpenRouter)
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Get your API key from: https://openrouter.ai/keys
# Verified free model: nvidia/nemotron-3-ultra-550b-a55b:free
# Other free options: see https://openrouter.ai/collections/free-models/

# Embedding Configuration (Local - Zero Cost)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_BASE_URL=local
EMBEDDING_DIMENSION=1024
# Local embeddings using Qwen3-Embedding-0.6B (no API billing required)
# First use will download model weights from Hugging Face (~1.5GB)
# Model runs on CPU by default, automatically uses GPU if available
# Produces 1024-dimensional vectors for semantic search

# Application Configuration
APP_NAME=ResearchMate AI
APP_VERSION=0.1.0
DEBUG=True

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
