# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/researchmate
# Example: postgresql://postgres:postgres@localhost:5432/researchmate

# LLM Configuration
# Option 1: OpenRouter (default, free models available)
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER=openai
# Get your API key from: https://openrouter.ai/keys

# Option 2: Google Gemini API with Gemma models (free tier, hosted by Google)
LLM_API_KEY=your_google_api_key_here
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_PROVIDER=gemini
# Get your API key from: https://aistudio.google.com
# Supported Gemma models: gemma-4-26b-a4b-it, gemma-4-31b-it
# Context window: 256K tokens
# Free tier: ~10-15 RPM, 1000-1500 RPD
# Note: Content used to improve Google products on free tier

# Embedding Configuration (Local - Zero Cost)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_BASE_URL=local
EMBEDDING_DIMENSION=1024
# Local embeddings using Qwen3-Embedding-0.6B (no API billing required)
# First use will download model weights from Hugging Face (~1.5GB)
# Model runs on CPU by default, automatically uses GPU if available
# Produces 1024-dimensional vectors for semantic search

# Application Configuration
APP_NAME=ResearchMate AI
APP_VERSION=0.1.0
DEBUG=True

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
